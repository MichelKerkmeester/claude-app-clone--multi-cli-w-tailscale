# Deployment-local config: holds the tailnet origin. Use serve.env.example as the template.
deploy/serve.env

.DS_Store

# Local symlink to shared external subagent tooling — not part of the app.
.pi-subagents

# Regenerated on every `node scripts/ui-audit.mjs` run; the script is the
# durable artefact, its report is not.
/ui-audit.json

# Track spec packets in this app repo (override ~/.gitignore_global /specs)
!/specs
!/specs/**

# ...except the vendored research repositories. Six read-only reference trees,
# 22k files and 569 MB of model weights, shared objects and GIFs. They are inputs,
# not source, and no LFS is configured, so committing them would put half a gigabyte
# into history permanently. This is the ignore the first-command-traps rule assumes.
/specs/context/

# Generated by scripts/docgen-coverage.mjs. The script is the deliverable; its
# census is a snapshot of a moving target and is silently wrong the moment a
# component gains a prop.
scripts/docgen-coverage.json

# Shared repo rules symlinked from the Public monorepo. Local rule files
# and the router beside them stay tracked; only the links are ignored.
repo-rules/blast-radius.md
repo-rules/communication.md
repo-rules/delegation-and-orchestration.md
repo-rules/evidence-and-proof.md
repo-rules/skill-hub-routing.md
repo-rules/prevent-overengineering.md
repo-rules/root-cause-and-debugging.md
repo-rules/scope-discipline.md
repo-rules/uncertainty-and-honesty.md
