# Exact HTTPS origin shown by `tailscale serve status`.
PI_REMOTE_PUBLIC_ORIGIN=https://host-name.tailnet-name.ts.net

# The relay and PWA remain loopback-only. Change only for a local port conflict.
PI_REMOTE_RELAY_PORT=4310
PI_REMOTE_WEB_PORT=4173

# Set to 1 only when a fresh local enrollment QR payload should be printed at startup.
PI_REMOTE_PRINT_ENROLLMENT=1
